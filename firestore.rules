rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    // "Authenticated STAFF": portal customers sign in with the same Firebase Auth but carry a
    // 'customer' custom claim — they are denied on every collection here and reach data only
    // through the portal BFF Cloud Functions (Admin SDK, which bypasses rules).
    function isAuth() {
      return request.auth != null && !('customer' in request.auth.token);
    }
    function isSuper() {
      // role claim is set by the authenticatePin Cloud Function at login.
      return request.auth != null && request.auth.token.role == 'superadmin';
    }
    function isAdmin() {
      // admin or super admin, per the role claim minted at login.
      return request.auth != null &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin');
    }

    // 🔒 SUPERADMIN-ONLY VAULT
    // Confidential data lives here. This is the ONLY rule that matches this path,
    // and there is no catch-all admin rule anywhere below — so admins cannot read it,
    // not just in the UI but at the database layer.
    match /superadmin_vault/{document=**} {
      allow read, write: if isSuper();
    }

    // 🚫 Server-only. Written by Cloud Functions via the Admin SDK (which bypasses
    // these rules). No client should ever touch it.
    match /security_logs/{document=**} {
      allow read, write: if false;
    }

    // ---- Configuration & system ----
    match /system/{document=**}                 { allow read, write: if isAuth(); }
    match /hq_config/{document=**}              { allow read, write: if isAuth(); }
    match /shop_config/{document=**}            { allow read, write: if isAuth(); }
    match /fin_config/{document=**}             { allow read, write: if isAuth(); }
    match /pick_config/{document=**}            { allow read, write: if isAuth(); }
    // 🔒 hq_users holds PINs (the doc id IS the PIN). Locked to admins: floor/library apps now read
    // the sanitized `directory` projection (below) for name/role joins, so only the HQ Admin UI still
    // touches hq_users. authenticatePin reads this via the Admin SDK, which bypasses these rules, so
    // PIN login is unaffected.
    match /hq_users/{document=**}               { allow read, write: if isAdmin(); }

    // 🔒 Sanitized projection of hq_users — { name, role, superAdmin } only, NO PIN. Written
    // server-side (Admin SDK bypasses rules) by mirrorUserToDirectory / backfillUserDirectory.
    // Clients read this for name/role joins so hq_users can be locked down.
    match /directory/{document=**}              { allow read: if isAuth(); allow write: if false; }

    // 🔒 Portal logins (people at customer accounts). Managed ONLY by the portal Cloud Functions
    // (createPortalUser & co. — Admin SDK). The CRM Portal Access panel reads it; admins only.
    match /portal_users/{document=**}           { allow read: if isAdmin(); allow write: if false; }

    // ---- Core PLM / CPQ ----
    match /Approved_Designs/{document=**}       { allow read, write: if isAuth(); }
    match /assembly_pins/{document=**}          { allow read, write: if isAuth(); }
    match /Design_Library/{document=**}         { allow read, write: if isAuth(); }
    match /jobs/{document=**}                   { allow read, write: if isAuth(); }
    match /cpq_flows/{document=**}              { allow read, write: if isAuth(); }
    match /cpq_drafts/{document=**}             { allow read, write: if isAuth(); }
    match /crm_records/{document=**}            { allow read, write: if isAuth(); }
    match /crm_files/{document=**}              { allow read, write: if isAuth(); }

    // ---- Shared assets, finishes, collections ----
    match /global_assets/{document=**}          { allow read, write: if isAuth(); }
    match /program_prints/{document=**}         { allow read, write: if isAuth(); }
    match /combo_images/{document=**}           { allow read, write: if isAuth(); }
    match /global_messages/{document=**}        { allow read, write: if isAuth(); }
    match /hq_collections/{document=**}         { allow read, write: if isAuth(); }
    match /hq_dynamic_data/{document=**}        { allow read, write: if isAuth(); }
    match /hq_global_finishes/{document=**}     { allow read, write: if isAuth(); }
    match /hq_inhouse_finishes/{document=**}    { allow read, write: if isAuth(); }
    match /hq_outsource_finishes/{document=**}  { allow read, write: if isAuth(); }
    match /packaging_templates/{document=**}    { allow read, write: if isAuth(); }
    match /packaging_orders/{document=**}       { allow read, write: if isAuth(); }
    match /standard_boxes/{document=**}         { allow read, write: if isAuth(); }
    match /project_images/{document=**}         { allow read, write: if isAuth(); }
    match /markups/{document=**}                { allow read, write: if isAuth(); }

    // ---- HQ logs, orders, inventory ----
    match /hq_logs/{document=**}                { allow read, write: if isAuth(); }
    match /hq_work_orders/{document=**}         { allow read, write: if isAuth(); }
    match /hq_sales_orders/{document=**}        { allow read, write: if isAuth(); }
    match /hq_purchase_orders/{document=**}     { allow read, write: if isAuth(); }
    match /ns_outbox/{document=**}              { allow read, write: if isAuth(); }
    match /id_counters/{document=**}            { allow read, write: if isAuth(); }
    match /hq_inventory_tasks/{document=**}     { allow read, write: if isAuth(); }

    // ---- Shop Floor ----
    match /shop_logs/{document=**}              { allow read, write: if isAuth(); }
    match /shop_custom_orders/{document=**}     { allow read, write: if isAuth(); }
    match /shop_routings/{document=**}          { allow read, write: if isAuth(); }
    match /shop_programs/{document=**}          { allow read, write: if isAuth(); }
    match /shop_machines/{document=**}          { allow read, write: if isAuth(); }
    match /shop_machine_categories/{document=**}{ allow read, write: if isAuth(); }
    match /shop_setup_codes/{document=**}       { allow read, write: if isAuth(); }
    match /shop_schedule/{document=**}          { allow read, write: if isAuth(); }
    match /shop_milling/{document=**}           { allow read, write: if isAuth(); }
    match /shop_tooling/{document=**}           { allow read, write: if isAuth(); }
    match /shop_materials/{document=**}         { allow read, write: if isAuth(); }
    match /shop_material_history/{document=**}  { allow read, write: if isAuth(); }
    match /shop_failures/{document=**}          { allow read, write: if isAuth(); }
    match /shop_finishing_alerts/{document=**}  { allow read, write: if isAuth(); }
    match /shop_livio/{document=**}             { allow read, write: if isAuth(); }

    // ---- Finishing Floor ----
    match /fin_workorders/{document=**}         { allow read, write: if isAuth(); }
    match /fin_recipes/{document=**}            { allow read, write: if isAuth(); }
    match /fin_paint_profiles/{document=**}     { allow read, write: if isAuth(); }
    match /fin_pots/{document=**}               { allow read, write: if isAuth(); }
    match /fin_supplies/{document=**}           { allow read, write: if isAuth(); }
    match /fin_logs/{document=**}               { allow read, write: if isAuth(); }
    match /fin_messaging/{document=**}          { allow read, write: if isAuth(); }
    match /fin_users/{document=**}              { allow read, write: if isAuth(); }
    match /plating_shipments/{document=**}      { allow read, write: if isAuth(); }
    match /plating_demand/{document=**}         { allow read, write: if isAuth(); }
    match /conversion_batches/{document=**}     { allow read, write: if isAuth(); }
    match /sample_chip_orders/{document=**}     { allow read, write: if isAuth(); }

    // Anything not explicitly listed above is denied by default.
  }
}
