rules_version = '2';

// Replaces the console-only `allow read, write: if true` (fully public bucket — anyone on the
// internet could read, upload, overwrite, or delete every object: GLBs, CAD, prints, photography).
//
// Locked to signed-in users (any PIN-minted token). Safe because the app has no unauthenticated
// storage path: every asset renders via getDownloadURL() token URLs — which bypass these rules and
// keep working — and all SDK reads/uploads happen after PIN login. The future customer portal will
// serve assets through its BFF (sanitized/watermarked), not direct bucket reads.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
